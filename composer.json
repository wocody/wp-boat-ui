{
    "name": "wocody/wp-boat-ui",
    "description": "Shared Tailwind CSS v4 admin interface for Wocody WordPress plugins: layout, sidebar navigation, settings sections and form components.",
    "type": "library",
    "keywords": ["wordpress", "admin", "ui", "tailwindcss", "design-system", "components"],
    "homepage": "https://github.com/wocody/wp-boat-ui",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Wocody",
            "homepage": "https://github.com/wocody"
        }
    ],
    "support": {
        "issues": "https://github.com/wocody/wp-boat-ui/issues",
        "source": "https://github.com/wocody/wp-boat-ui"
    },
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "wp-coding-standards/wpcs": "^3.2",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "autoload": {
        "files": ["bootstrap.php"]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "php tests/run.php",
        "standards": "phpcs"
    },
    "archive": {
        "exclude": ["/node_modules", "/tests", "/tools", "/preview", "/docs", "/resources/css/safelist.txt", "/.github", "/package.json", "/package-lock.json", "/phpcs.xml.dist"]
    }
}
